# Gemini API key — required for OCR and visual translation.
# Copy this file to .env (which is git-ignored) and replace the value below
# with your real key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Signing configuration (Optional for local debug builds, required for release)
# KEYSTORE_PATH=C:/path/to/your/release-key.jks
# STORE_PASSWORD=your_keystore_password
# KEY_ALIAS=your_key_alias
# KEY_PASSWORD=your_key_password
