# The Android app reads OPENROUTER_API_KEY only from local.properties (git-ignored), or uses the backend (backend/.env).

# Signing configuration (Optional for local debug builds, required for release)
# KEYSTORE_PATH=C:/path/to/your/release-key.jks
# STORE_PASSWORD=your_keystore_password
# KEY_ALIAS=your_key_alias
# KEY_PASSWORD=your_key_password
