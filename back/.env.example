# Free key: https://openrouter.ai/settings/keys (only :free models are forwarded)
OPENROUTER_API_KEY=MY_OPENROUTER_API_KEY
PORT=8080
# Strongly recommended when the backend is public: the app must send the same value in the
# X-MangaLens-Token header (build the APK with TRANSLATION_API_TOKEN=<same value>).
MANGALENS_APP_TOKEN=
# Set to 1 only behind a reverse proxy (Render, Railway, Fly, nginx) that sets X-Forwarded-For,
# so each phone gets its own rate limit instead of all users sharing the proxy's address.
TRUST_PROXY=0
# Requests per minute: per phone, and in total for the shared OpenRouter key (free tier: 20/min).
PER_CLIENT_RATE_LIMIT=10
GLOBAL_RATE_LIMIT=18
